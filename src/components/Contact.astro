---
import fs from "node:fs";
import path from "node:path";
import Recaptcha from "./Recaptcha.astro";

/**
 * Contact Component
 * A premium, glassmorphic contact form for Astro.
 */
let recaptchaSiteKey = "6LcII10sAAAAANyn2S32IaW5kUF6nc8mXA8Ef7bs"; // Default test key
try {
    const envPath = path.resolve(process.cwd(), ".mail.env");
    if (fs.existsSync(envPath)) {
        const envContent = fs.readFileSync(envPath, "utf-8");
        const match = envContent.match(/^RECAPTCHA_SITE_KEY=(.*)$/m);
        if (match && match[1]) {
            recaptchaSiteKey = match[1].trim();
        }
    }
} catch (e) {
    console.error("Could not load RECAPTCHA_SITE_KEY from .mail.env");
}
---

<section id="contact" class="relative isolate overflow-hidden py-16 sm:py-24 px-4 sm:px-6 lg:px-8">
    <!-- Ambient glow decorations -->
    <div
        class="absolute -top-32 left-1/2 -translate-x-1/2 -z-10 w-96 sm:w-162.5 h-96 sm:h-162.5 rounded-full bg-linear-to-tr from-indigo-600/20 via-purple-600/15 to-transparent blur-3xl pointer-events-none"
        aria-hidden="true"
    ></div>
    <div
        class="absolute bottom-10 right-1/4 -z-10 w-72 h-72 rounded-full bg-indigo-500/10 blur-3xl pointer-events-none"
        aria-hidden="true"
    ></div>

    <div class="max-w-2xl mx-auto">
        <!-- Header -->
        <div class="text-center mb-10 sm:mb-12">
            <span
                class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold tracking-wider uppercase text-indigo-400 bg-indigo-500/10 border border-indigo-500/20 shadow-sm shadow-indigo-500/10 mb-4"
            >
                <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 animate-pulse"></span>
                Get in Touch
            </span>
            <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-4">
                Let's Start a <span class="bg-linear-to-r from-indigo-400 via-purple-400 to-pink-400 bg-clip-text text-transparent">Conversation</span>
            </h1>
            <p class="text-base sm:text-lg text-slate-400 max-w-lg mx-auto">
                Fill out the form below and we'll get back to you within 24 hours.
            </p>
        </div>

        <!-- Form Card Container -->
        <div class="relative rounded-3xl bg-slate-900/70 backdrop-blur-xl border border-slate-800/80 shadow-2xl shadow-black/40 p-6 sm:p-10 transition-all duration-300 hover:border-slate-700/80">
            <form
                id="contactForm"
                action="/api/send.php"
                method="POST"
                class="space-y-6"
            >
                <!-- Honeypot Field (Anti-Spam) -->
                <input
                    type="text"
                    name="_honey"
                    class="hidden"
                    tabindex="-1"
                    autocomplete="off"
                    aria-hidden="true"
                />

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <!-- Full Name -->
                    <div>
                        <label for="name" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
                            Full Name <span class="text-indigo-400">*</span>
                        </label>
                        <input
                            type="text"
                            id="name"
                            name="name"
                            placeholder="John Doe"
                            required
                            class="w-full px-4 py-3 rounded-xl bg-slate-950/60 border border-slate-800 text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 hover:border-slate-700 text-sm transition-all duration-200"
                        />
                    </div>

                    <!-- Email Address -->
                    <div>
                        <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
                            Email Address <span class="text-indigo-400">*</span>
                        </label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="john@example.com"
                            required
                            class="w-full px-4 py-3 rounded-xl bg-slate-950/60 border border-slate-800 text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 hover:border-slate-700 text-sm transition-all duration-200"
                        />
                    </div>
                </div>

                <!-- Subject -->
                <div>
                    <label for="subject" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
                        Subject <span class="text-indigo-400">*</span>
                    </label>
                    <input
                        type="text"
                        id="subject"
                        name="subject"
                        placeholder="Project Inquiry"
                        required
                        class="w-full px-4 py-3 rounded-xl bg-slate-950/60 border border-slate-800 text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 hover:border-slate-700 text-sm transition-all duration-200"
                    />
                </div>

                <!-- Message -->
                <div>
                    <label for="message" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
                        Message <span class="text-indigo-400">*</span>
                    </label>
                    <textarea
                        id="message"
                        name="message"
                        rows="5"
                        placeholder="How can we help you?"
                        required
                        class="w-full px-4 py-3 rounded-xl bg-slate-950/60 border border-slate-800 text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 hover:border-slate-700 text-sm transition-all duration-200 resize-none"
                    ></textarea>
                </div>

                <!-- reCAPTCHA v3 will run invisibly on submit -->

                <!-- Submit Button -->
                <button
                    type="submit"
                    id="submitBtn"
                    class="group relative w-full inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl text-sm font-semibold text-white bg-linear-to-r from-indigo-500 via-indigo-600 to-purple-600 hover:from-indigo-600 hover:via-indigo-700 hover:to-purple-700 active:scale-95 transition-all duration-200 shadow-lg shadow-indigo-500/25 hover:shadow-indigo-500/40 cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
                >
                    <span id="btnText">Send Message</span>
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="transition-transform duration-200 group-hover:translate-x-1"
                    >
                        <line x1="22" y1="2" x2="11" y2="13"></line>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                    </svg>
                </button>

                <!-- Status Feedback -->
                <div id="formStatus" class="hidden text-sm text-center font-medium transition-all duration-200" role="alert"></div>
            </form>
        </div>
    </div>
</section>

<script>
    const form = document.getElementById("contactForm") as HTMLFormElement;
    const status = document.getElementById("formStatus");
    const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement;
    const btnText = document.getElementById("btnText");

    form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!status) return;

        // Reset & show loading state
        status.textContent = "Sending message...";
        status.className = "flex items-center justify-center gap-2 p-3.5 rounded-xl text-sm font-medium bg-indigo-500/10 border border-indigo-500/20 text-indigo-300 animate-pulse";

        if (submitBtn) submitBtn.disabled = true;
        if (btnText) btnText.textContent = "Sending...";

        const formData = new FormData(form);

        try {
            const response = await fetch(form.action, {
                method: "POST",
                body: formData,
            });

            const result = await response.json();

            if (result.success) {
                status.textContent = result.message || "Message sent successfully!";
                status.className = "flex items-center justify-center gap-2 p-3.5 rounded-xl text-sm font-medium bg-emerald-500/10 border border-emerald-500/30 text-emerald-400";
                form.reset();
            } else {
                status.textContent = result.message || "Something went wrong.";
                status.className = "flex items-center justify-center gap-2 p-3.5 rounded-xl text-sm font-medium bg-rose-500/10 border border-rose-500/30 text-rose-400";
            }
        } catch (error) {
            status.textContent = "Could not connect to the server.";
            status.className = "flex items-center justify-center gap-2 p-3.5 rounded-xl text-sm font-medium bg-rose-500/10 border border-rose-500/30 text-rose-400";
        } finally {
            if (submitBtn) submitBtn.disabled = false;
            if (btnText) btnText.textContent = "Send Message";
        }
    });
</script>

<!-- ReCAPTCHA v3 — loads the API and injects the token before each submit -->
<Recaptcha siteKey={recaptchaSiteKey} formId="contactForm" />
